          <mxGeometry x="715" y="240" width="135" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="orth" value="正交扩散映射&lt;br&gt;QR 核 Q" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDECFC;strokeColor=#655BB9;fontSize=13;" vertex="1" parent="1">
