<mxfile host="app.diagrams.net" modified="2026-06-12T00:00:00.000Z" agent="Codex" version="26.0.0" type="device">
  <diagram id="ra-mam-flow" name="RA-MAM嵌入恢复流程">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="第三章方法流程图：可靠性感知混合字母表嵌入与恢复（RA-MAM）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#12405E;" vertex="1" parent="1">
          <mxGeometry x="160" y="25" width="1280" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="sendBand" value="发送端：载荷到初始潜变量，再由 Stable Diffusion 生成含载荷图像" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E2F1F8;strokeColor=#407D99;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1520" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="channelBand" value="信道与图像扰动：PNG/JPEG、缩放、模糊、噪声等会引入反演误差" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF4DE;strokeColor=#BE8839;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1520" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="recvBand" value="接收端：图像反演回潜空间，逆映射并利用置信度/CRC恢复载荷" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E9F4E8;strokeColor=#5B9056;fontSize=16;fontStyle=1;" vertex="1" parent="1">
