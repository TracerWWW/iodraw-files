        <!-- Path 4: C2_L (415) to RGB.G_R (325) - Crosses Path 3 perfectly at (375, 295) -->
        <mxCell id="route_4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=1.25;endArrow=blockThin;endFill=1;endSize=5;" parent="1" edge="1">
